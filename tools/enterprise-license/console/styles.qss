/* 浅色主题，等宽呈现 JWT */
QMainWindow, QWidget {
    background-color: #f5f6f8;
    color: #1f2329;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d8dce3;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #2b6cb0;
    font-weight: bold;
}
QLabel { color: #1f2329; }
QLineEdit, QSpinBox, QComboBox, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #cbd2dc;
    border-radius: 4px;
    padding: 4px 6px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #2b6cb0;
}
QTextEdit#jwt {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}
QPushButton {
    background-color: #2b6cb0;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
}
QPushButton:hover { background-color: #245a93; }
QPushButton:disabled { background-color: #b9c2cf; color: #eef1f5; }
QTabWidget::pane { border: 1px solid #d8dce3; border-radius: 6px; top: -1px; }
QTabBar::tab {
    background: #e7ebf0;
    padding: 7px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected { background: #ffffff; color: #2b6cb0; font-weight: bold; }
QListWidget, QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d8dce3;
    border-radius: 4px;
    alternate-background-color: #f0f3f7;
}
QHeaderView::section {
    background-color: #e7ebf0;
    border: none;
    padding: 4px;
}
QStatusBar { background-color: #eef1f5; color: #1f2329; }
#statusBig {
    font-size: 18px;
    font-weight: bold;
    color: #1e7e34;
}
QDockWidget {
    titlebar-close-icon: none;
}
